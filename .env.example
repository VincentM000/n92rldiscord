# ==============================================================================
# Nanterre Pirates — Configuration des variables d'environnement (.env)
# Copiez ce fichier en `.env` et renseignez vos propres webhooks (ne jamais commiter `.env`).
# ==============================================================================

# Webhook Discord principal (Captain Hook : NRL, Super League, Super XIII, Live Monitor, RSS)
DISCORD_CAPTAIN_HOOK_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Webhook Discord pour Nami (météo entraînements & matchs)
DISCORD_NAMI_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Dossier persistant hors du dépôt Git pour stocker les fichiers d'état (anti-spam)
STATE_DIR=/home/pirates/n92rldiscord-state

# --- Options facultatives pour weather-notifier (Nami) ---
# WEATHER_BOT_NAME=Nami
# WEATHER_LAT=48.8924
# WEATHER_LON=2.2069
# WEATHER_LOCATION_NAME=Nanterre
# MATCH_SCHEDULE_FILE=matches.txt
