[Unit]
Description=Super XIII Standings, Match Results & YouTube Live Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pirates
Group=pirates
WorkingDirectory=/opt/n92rldiscord
Environment="RUST_LOG=info"
ExecStart=/opt/n92rldiscord/target/release/super-xiii-tracker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
