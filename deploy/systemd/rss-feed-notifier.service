[Unit]
Description=Treize Mondial RSS News Feed Notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vincent
WorkingDirectory=/home/vincent/n92rldiscord
Environment="RUST_LOG=info"
ExecStart=/home/vincent/n92rldiscord/target/release/rss-feed-notifier
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
