[Unit]
Description=NRL Standings & Match Results Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pirates
Group=pirates
WorkingDirectory=/opt/n92rldiscord
Environment="RUST_LOG=info"
ExecStart=/opt/n92rldiscord/target/release/nrl-tracker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
